{
  "name": "@fw-booking/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hintergrund-Worker: arbeitet Outbox-Jobs mit Leases und Wiederholungen ab.",
  "scripts": {
    "dev": "node --conditions=development --env-file-if-exists=../../.env --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fw-booking/db": "workspace:*",
    "@fw-booking/shared": "workspace:*",
    "mongodb": "^7.7.0",
    "nodemailer": "10.0.10",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@types/mailparser": "3.4.6",
    "@types/node": "^26.6.4",
    "@types/smtp-server": "3.5.13",
    "mailparser": "3.9.28",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "smtp-server": "3.19.13"
  }
}

{
  "name": "@fw-booking/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Buchungs-API (NestJS, Express, MongoDB).",
  "scripts": {
    "dev": "node --conditions=development --env-file-if-exists=../../.env --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "swc src -d dist --strip-leading-paths --ignore '**/*.test.ts' --ignore 'src/testing/**'",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env --conditions=development --import @swc-node/register/esm-register src/database/migrate.ts",
    "db:migrate:dist": "node --env-file-if-exists=../../.env dist/database/migrate.js",
    "owner:create": "node --env-file-if-exists=../../.env --conditions=development --import @swc-node/register/esm-register src/auth/owner-create.cli.ts",
    "owner:create:dist": "node --env-file-if-exists=../../.env dist/auth/owner-create.cli.js",
    "test:concurrency": "node scripts/concurrency.mjs"
  },
  "dependencies": {
    "@fw-booking/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "mongodb": "^7.7.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0"
  }
}

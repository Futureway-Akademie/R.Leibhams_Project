{
  "name": "@fw-booking/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gemeinsame Domänentypen, Validierung und Zeitzonen-Utilities.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./src/time/format.ts",
      "development": "./src/time/format.ts",
      "default": "./dist/time/format.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ]
}

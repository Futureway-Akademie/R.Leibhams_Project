# Lokale Entwicklung (siehe infra/README.md). Kopieren nach .env; echte Werte gehören in .env bzw.
# den Secret Store, nie ins Repository.

# API und Worker
MONGODB_URI=mongodb://localhost:27017/fw_booking?replicaSet=rs0
LOG_LEVEL=info

# API
HOST=127.0.0.1
PORT=3000
# Secure-Cookies; Standard: true nur bei NODE_ENV=production (lokal läuft die API über http)
# SESSION_COOKIE_SECURE=false
# Anzahl Reverse-Proxys vor der API (für die Client-IP beim Login-Schutz)
TRUST_PROXY=0
# Origins der WordPress-Seiten, die das Widget einbinden (exakt, kommagetrennt, ohne Pfad)
CORS_ALLOWED_ORIGINS=
# Ratenbegrenzung je Client-IP (0 = aus): Lesen und Verwaltungslink-Ansicht je Minute,
# Buchen sowie Storno/Umbuchung je 10 Minuten; neue Buchungen je E-Mail-Adresse und Stunde
# RATE_LIMIT_READ=120
# RATE_LIMIT_BOOKING=10
# RATE_LIMIT_MANAGE_READ=60
# RATE_LIMIT_MANAGE_WRITE=10
# BOOKING_LIMIT_PER_EMAIL=5

# Worker: gleichzeitig bearbeitete Jobs und Abfrageabstand ohne fällige Jobs
# WORKER_CONCURRENCY=4
# WORKER_POLL_INTERVAL_MS=5000

# Worker / E-Mail (lokal Mailpit, Oberfläche http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM_ADDRESS=termine@example.test
# MAIL_REPLY_TO=info@example.test
BUSINESS_NAME=Mein Betrieb
# BUSINESS_PHONE=030 123456
# Seite mit dem Buchungs-Widget für die Selbstverwaltung (Link: MANAGE_PAGE_URL#t=TOKEN)
MANAGE_PAGE_URL=http://localhost:8080/termin-verwalten

{
  "name": "wp-buchung-kalender-plus-pwa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:verify": "infra/verify.sh",
    "wp:assets": "pnpm --filter @fw-booking/widget build && node plugins/wordpress/copy-widget-assets.mjs",
    "wp:up": "pnpm wp:assets && docker compose -f infra/docker-compose.wordpress.yml up -d --wait && infra/wordpress-setup.sh",
    "wp:down": "docker compose -f infra/docker-compose.wordpress.yml down",
    "wp:reset": "docker compose -f infra/docker-compose.wordpress.yml down -v",
    "wp:cli": "docker compose -f infra/docker-compose.wordpress.yml run --rm cli wp",
    "wp:lint": "docker run --rm -v \"$PWD/plugins/wordpress/fw-booking:/plugin:ro\" wordpress:7.1-php8.4-apache sh -c 'find /plugin -name \"*.php\" -print0 | xargs -0 -n1 php -l'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
